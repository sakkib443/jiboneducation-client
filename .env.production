# Production API base URL.
# Committed intentionally (see .gitignore note: "can opt-in for committing if needed").
# NEXT_PUBLIC_* values are inlined into the browser bundle by design — this is a public URL, not a secret.
# A NEXT_PUBLIC_API_URL set in the Vercel dashboard will override this value.
NEXT_PUBLIC_API_URL=https://jiboneducation-server.vercel.app/api
